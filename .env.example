# ─── Brand ──────────────────────────────────────────────────────────
# Displayed in the auth wordmark, landing hero, topnav, and metadata title.
NEXT_PUBLIC_BRAND_NAME=Open Chat

# ─── Mock mode ──────────────────────────────────────────────────────
# When true, all /api/* routes return local fixtures (src/mocks/).
# The UI is fully browsable, and chat returns canned SSE responses.
# Set to false when connecting a real backend.
NEXT_PUBLIC_USE_MOCK=true

# ─── Backend (when NEXT_PUBLIC_USE_MOCK=false) ──────────────────────
# Public-facing OpenAI-compatible API URL, shown in the developer hub.
NEXT_PUBLIC_API_BASE_URL=

# Internal upstream URLs (server-side).
NEWAPI_INTERNAL_URL=http://localhost:3000
CONV_SERVICE_URL=http://localhost:4000

# Public origin — used when rewriting Set-Cookie domain on login.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001

# Cookie attributes for the rewritten session cookie.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false

# ─── Optional: Azure OpenAI TTS for /api/audio/speech ───────────────
# Leave blank to disable the read-aloud button; otherwise fill all four.
AZURE_TTS_ENDPOINT=
AZURE_TTS_KEY=
AZURE_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_TTS_API_VERSION=2025-03-01-preview
